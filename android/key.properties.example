# ⚠️ 이 파일은 템플릿입니다. 실제 사용 시 같은 폴더에
# `key.properties` 라는 이름으로 복사한 뒤 본인 키로 채우세요.
# (`key.properties` 와 .jks 파일은 .gitignore 로 보호됩니다.)
#
# storeFile 은 absolute path 또는 android/app/ 기준 상대경로 모두 허용됩니다.
# 예) android/app/upload-keystore.jks 에 두면 storeFile=upload-keystore.jks

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
